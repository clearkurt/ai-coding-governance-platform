# PostgreSQL only. SQLite is intentionally not supported by the target API.
COMPANY_AGENT_DATABASE_URL=postgresql+asyncpg://company_agent:change-me@localhost:5432/company_agent
COMPANY_AGENT_ENVIRONMENT=development
COMPANY_AGENT_LOG_LEVEL=INFO
COMPANY_AGENT_SESSION_COOKIE_SECURE=false

# The real key stays on the central API only. Never copy it into the web or daemon configuration.
COMPANY_AGENT_DEEPSEEK_API_KEY=replace-with-server-only-key
COMPANY_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
COMPANY_AGENT_RESPONSES_MAX_BODY_BYTES=2097152
COMPANY_AGENT_RESPONSES_TIMEOUT_SECONDS=120
COMPANY_AGENT_RESPONSES_MAX_CONCURRENCY=32
COMPANY_AGENT_MODEL_TOKEN_TTL_SECONDS=300
COMPANY_AGENT_MODEL_DAILY_TOKEN_QUOTA_PER_TEAM=1000000
